{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "baseUrl": "..",
    "paths": { "@shared/*": ["./shared/src/*"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../shared/src/**/*.ts"]
}

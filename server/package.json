{
  "name": "@anwo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "安窝 Anwo API server — Express 5 + node:sqlite + ws",
  "scripts": {
    "dev": "ENABLE_DEV_API=1 NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "seed": "node --disable-warning=ExperimentalWarning --import tsx src/db/seed/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anwo/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "ws": "^8.22.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

{
  "$schema": "https://example.invalid/anwo-tokens.schema.json",
  "meta": {
    "name": "安窝 Anwo design tokens",
    "version": "1.0.0",
    "source": "docs/DESIGN.md §3; CSS twin: docs/design/theme.css",
    "accentHue": "persimmon",
    "contrastTarget": "WCAG AA 4.5:1 for all text pairs (see DESIGN.md §3.1 table)"
  },
  "brand": {
    "nameZh": "安窝",
    "nameEn": "Anwo",
    "taglineZh": "安心落脚，从校园开始。",
    "taglineEn": "Settle in safely, starting at campus.",
    "markColor": "{color.raw.persimmon.500}",
    "wordmarkColor": "{color.light.ink}"
  },
  "color": {
    "raw": {
      "persimmon": {
        "50": "#FFF3EC",
        "100": "#FFE1D1",
        "200": "#FFCDB5",
        "300": "#FFAB85",
        "400": "#FB8A5A",
        "500": "#E35A2B",
        "600": "#C2410C",
        "700": "#A23A12",
        "800": "#822F11",
        "900": "#67280F",
        "950": "#3B1508"
      },
      "stone": {
        "0": "#FFFFFF",
        "50": "#FBF8F3",
        "100": "#F3EEE6",
        "200": "#E7E0D5",
        "300": "#CFC6B8",
        "400": "#A39B90",
        "500": "#6F6861",
        "600": "#57514A",
        "700": "#3A3531",
        "800": "#272320",
        "850": "#1D1A17",
        "900": "#1C1917",
        "950": "#141210"
      }
    },
    "light": {
      "paper": "#FBF8F3",
      "surface": "#FFFFFF",
      "sunken": "#F3EEE6",
      "overlay": "rgba(28,25,23,0.48)",
      "inverse": "#1C1917",
      "line": "#E7E0D5",
      "lineStrong": "#CFC6B8",
      "ink": "#1C1917",
      "ink2": "#57514A",
      "ink3": "#6F6861",
      "ink4": "#A39B90",
      "inkInverse": "#FBF8F3",
      "accent": "#C2410C",
      "accentHover": "#A23A12",
      "accentActive": "#822F11",
      "accentText": "#C2410C",
      "accentTextStrong": "#A23A12",
      "accentSoft": "#FFF3EC",
      "accentSoftLine": "#FFCDB5",
      "accentVivid": "#E35A2B",
      "onAccent": "#FFFFFF",
      "success": "#1E7245",
      "successSoft": "#E2F3E9",
      "onSuccess": "#FFFFFF",
      "warning": "#8A5200",
      "warningSoft": "#FBEFD4",
      "warningFill": "#F2B84B",
      "danger": "#B42318",
      "dangerSoft": "#FDE8E6",
      "onDanger": "#FFFFFF",
      "info": "#2A5D8F",
      "infoSoft": "#E4EEF7",
      "focusRing": "#E35A2B"
    },
    "dark": {
      "paper": "#141210",
      "surface": "#1D1A17",
      "sunken": "#272320",
      "overlay": "rgba(0,0,0,0.6)",
      "inverse": "#F2EDE6",
      "line": "#2F2A26",
      "lineStrong": "#4A433D",
      "ink": "#F2EDE6",
      "ink2": "#BDB5AB",
      "ink3": "#948C82",
      "ink4": "#6B645C",
      "inkInverse": "#141210",
      "accent": "#C2410C",
      "accentHover": "#E35A2B",
      "accentActive": "#FB8A5A",
      "accentText": "#FB8A5A",
      "accentTextStrong": "#FFAB85",
      "accentSoft": "#3B1508",
      "accentSoftLine": "#67280F",
      "accentVivid": "#E35A2B",
      "onAccent": "#FFFFFF",
      "success": "#5FCB8F",
      "successSoft": "#12291C",
      "onSuccess": "#141210",
      "warning": "#F2B84B",
      "warningSoft": "#2E2108",
      "warningFill": "#F2B84B",
      "danger": "#F47F75",
      "dangerSoft": "#3A1512",
      "onDanger": "#141210",
      "info": "#82B4E3",
      "infoSoft": "#13233A",
      "focusRing": "#FB8A5A"
    },
    "contrast": {
      "light": {
        "ink/paper": 16.51,
        "ink2/paper": 7.39,
        "ink3/paper": 5.18,
        "ink3/sunken": 4.75,
        "ink/sunken": 15.14,
        "accentText/paper": 4.89,
        "accentTextStrong/paper": 6.29,
        "accentTextStrong/accentSoft": 6.12,
        "onAccent/accent": 5.18,
        "success/paper": 5.59,
        "success/successSoft": 5.14,
        "warning/paper": 6.03,
        "warning/warningSoft": 5.6,
        "danger/paper": 6.21,
        "danger/dangerSoft": 5.59,
        "onDanger/danger": 6.57,
        "info/paper": 6.48,
        "info/infoSoft": 5.84,
        "focusRing/paper(nonText,needs3)": 3.44,
        "inkInverse/inverse": 16.51
      },
      "dark": {
        "ink/paper": 16.05,
        "ink2/paper": 9.22,
        "ink3/paper": 5.64,
        "ink3/sunken": 4.7,
        "ink/surface": 14.87,
        "accentText/paper": 7.91,
        "accentText/surface": 7.33,
        "accentTextStrong/accentSoft": 8.8,
        "onAccent/accent": 5.18,
        "success/paper": 9.28,
        "success/successSoft": 7.67,
        "warning/paper": 10.44,
        "warning/warningSoft": 8.77,
        "danger/paper": 7.24,
        "danger/dangerSoft": 6.28,
        "info/paper": 8.53,
        "info/infoSoft": 7.21,
        "inkInverse/inverse": 16.05,
        "accentTextStrong/paper": 10.16,
        "focusRing/paper(nonText,needs3)": 7.91
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "\"Inter\", \"Noto Sans SC\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Source Han Sans SC\", \"Noto Sans CJK SC\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "display": "\"Inter\", \"Noto Sans SC\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Source Han Sans SC\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, \"Noto Sans Mono CJK SC\", monospace"
    },
    "webfontPolicy": "No webfont request on the critical path. System stacks only; an optional self-hosted Inter/Noto Sans SC subset may be added later with font-display: optional.",
    "scale": {
      "display": {
        "size": 40,
        "lineHeight": 44,
        "weight": 700,
        "tracking": "-0.02em",
        "mobileSize": 32,
        "mobileLineHeight": 36
      },
      "h1": {
        "size": 28,
        "lineHeight": 34,
        "weight": 700,
        "tracking": "-0.015em",
        "mobileSize": 24,
        "mobileLineHeight": 30
      },
      "h2": {
        "size": 22,
        "lineHeight": 28,
        "weight": 600,
        "tracking": "-0.01em"
      },
      "h3": {
        "size": 18,
        "lineHeight": 24,
        "weight": 600,
        "tracking": "0"
      },
      "bodyLg": {
        "size": 17,
        "lineHeight": "1.5 (zh 1.65)",
        "weight": 400
      },
      "body": {
        "size": 15,
        "lineHeight": "1.5 (zh 1.65)",
        "weight": 400
      },
      "small": {
        "size": 13,
        "lineHeight": 18,
        "weight": 400
      },
      "caption": {
        "size": 12,
        "lineHeight": 16,
        "weight": 500,
        "tracking": "0.01em"
      },
      "priceLg": {
        "size": 24,
        "lineHeight": 28,
        "weight": 700,
        "tracking": "-0.01em",
        "numeric": "tabular-nums"
      },
      "price": {
        "size": 17,
        "lineHeight": 22,
        "weight": 700,
        "numeric": "tabular-nums"
      }
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "leading": {
      "tight": 1.2,
      "snug": 1.33,
      "bodyEn": 1.5,
      "bodyZh": 1.65,
      "relaxed": 1.7
    },
    "tracking": {
      "tight": "-0.02em",
      "snug": "-0.01em",
      "normal": "0",
      "wide": "0.01em",
      "caps": "0.06em"
    },
    "inputFontSizeMobile": 16
  },
  "spacing": {
    "base": 4,
    "scale": {
      "0": 0,
      "0.5": 2,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64,
      "20": 80,
      "24": 96
    },
    "semantic": {
      "gutterMobile": 16,
      "gutterDesktop": 32,
      "cardPadding": 16,
      "cardPaddingLg": 20,
      "sectionGapMobile": 32,
      "sectionGapDesktop": 48,
      "gridGapMobile": 12,
      "gridGapDesktop": 20,
      "stackTight": 4,
      "stack": 8,
      "stackLoose": 16
    }
  },
  "radius": {
    "xs": 4,
    "sm": 6,
    "ctl": 10,
    "card": 14,
    "lg": 20,
    "pill": 999,
    "signature": "card = 14px; nested image radius = outer radius − padding (14 − 8 = 6 when inset 8px; images flush to card edge keep 14 on outer corners)"
  },
  "border": {
    "hairline": "1px solid {line}",
    "strong": "1px solid {lineStrong}",
    "inputFocus": "1px solid {accent} + outline 2px {focusRing} offset 2px",
    "divider": "1px {line}"
  },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgba(28,25,23,0.06)",
      "md": "0 4px 16px -4px rgba(28,25,23,0.12), 0 1px 2px rgba(28,25,23,0.04)",
      "lg": "0 16px 40px -12px rgba(28,25,23,0.18), 0 2px 6px rgba(28,25,23,0.06)",
      "pin": "0 2px 6px rgba(28,25,23,0.18)"
    },
    "dark": {
      "sm": "0 1px 2px rgba(0,0,0,0.4)",
      "md": "0 4px 16px -4px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.04)",
      "lg": "0 16px 40px -12px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.05)",
      "pin": "0 2px 6px rgba(0,0,0,0.5)"
    },
    "usage": "Cards at rest: none (hairline only). Hover card: sm. Popover/dropdown: md. Modal/sheet/map-card overlay: lg. Map price pin: pin."
  },
  "motion": {
    "duration": {
      "fast": 120,
      "base": 180,
      "slow": 280,
      "sheet": 320
    },
    "easing": {
      "out": "cubic-bezier(0.2, 0, 0, 1)",
      "inOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "emphasis": "cubic-bezier(0.3, 1.2, 0.4, 1)"
    },
    "reducedMotion": "prefers-reduced-motion: reduce → all durations 0ms; opacity-only fades allowed; no translate/scale; map flyTo becomes setView.",
    "animations": {
      "fadeIn": "opacity 0→1, base/out",
      "riseIn": "opacity 0→1 + translateY 8px→0, slow/out",
      "sheetUp": "translateY 100%→0, sheet/out",
      "pinPop": "scale 0.9→1.08, base/emphasis",
      "shimmer": "skeleton background-position sweep 1.4s linear infinite"
    }
  },
  "zIndex": {
    "base": 0,
    "raised": 10,
    "sticky": 20,
    "nav": 30,
    "dropdown": 40,
    "overlay": 50,
    "modal": 60,
    "toast": 70,
    "tooltip": 80
  },
  "breakpoints": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1440
  },
  "layout": {
    "containers": {
      "content": 1200,
      "detail": 1120,
      "reading": 720,
      "form": 576
    },
    "shell": {
      "navHeightDesktop": 64,
      "navHeightMobile": 56,
      "tabBarHeight": 60,
      "tabBarSafeArea": "env(safe-area-inset-bottom)"
    },
    "grid": {
      "columnsMobile": 1,
      "columnsSm": 2,
      "columnsLg": 3,
      "columnsXl": 4,
      "gapMobile": 12,
      "gapDesktop": 20
    },
    "mapSplit": {
      "listWidthLg": 560,
      "listWidthXl": 640,
      "mapMin": 480
    }
  },
  "components": {
    "button": {
      "height": {
        "sm": 32,
        "md": 40,
        "lg": 48
      },
      "paddingX": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "fontSize": {
        "sm": 13,
        "md": 15,
        "lg": 16
      },
      "radius": 10,
      "iconSize": {
        "sm": 16,
        "md": 18,
        "lg": 20
      },
      "minTouchTarget": 44
    },
    "input": {
      "height": {
        "sm": 36,
        "md": 40,
        "lg": 48
      },
      "paddingX": 12,
      "radius": 10,
      "fontSize": 15,
      "fontSizeMobile": 16
    },
    "chip": {
      "height": 32,
      "paddingX": 12,
      "radius": 999,
      "fontSize": 13,
      "gap": 6
    },
    "card": {
      "radius": 14,
      "padding": 16,
      "border": "1px line",
      "imageAspectListing": "4 / 3",
      "imageAspectItem": "1 / 1"
    },
    "avatar": {
      "sizes": {
        "xs": 24,
        "sm": 32,
        "md": 40,
        "lg": 56,
        "xl": 88
      },
      "trustRingWidth": 2,
      "trustRingGap": 2
    },
    "badge": {
      "height": 22,
      "paddingX": 8,
      "radius": 6,
      "fontSize": 12
    },
    "mapPin": {
      "height": 28,
      "paddingX": 10,
      "radius": 999,
      "fontSize": 13,
      "weight": 600,
      "border": 1.5,
      "tail": 6,
      "selectedScale": 1.08,
      "clusterSize": 36
    },
    "tabBar": {
      "height": 60,
      "iconSize": 24,
      "labelSize": 11
    },
    "toast": {
      "width": 360,
      "maxWidthMobile": "calc(100vw - 32px)",
      "duration": {
        "info": 4000,
        "success": 3000,
        "error": 6000
      }
    },
    "modal": {
      "widths": {
        "sm": 420,
        "md": 560,
        "lg": 760
      },
      "radius": 14,
      "padding": 24
    },
    "sheet": {
      "radiusTop": 14,
      "handle": "36×4 line-strong pill",
      "maxHeight": "88dvh",
      "snapPoints": [
        0.5,
        0.88
      ]
    },
    "tooltip": {
      "bg": "{inverse}",
      "fg": "{inkInverse}",
      "fontSize": 12,
      "padding": "6px 8px",
      "radius": 6,
      "delayMs": 400
    }
  },
  "trust": {
    "levels": {
      "0": {
        "key": "unverified",
        "zh": "未验证",
        "en": "Unverified",
        "shape": "none (dashed circle in profile only)",
        "color": "{ink4}",
        "ringColor": "none"
      },
      "1": {
        "key": "email",
        "zh": "邮箱已验证",
        "en": "Email verified",
        "shape": "circle-check outline",
        "color": "{ink2}",
        "ringColor": "{lineStrong}"
      },
      "2": {
        "key": "student",
        "zh": "学生认证",
        "en": "Student verified",
        "shape": "shield filled + check",
        "color": "{accent}",
        "ringColor": "{accentVivid}"
      },
      "3": {
        "key": "full",
        "zh": "完全认证",
        "en": "Fully verified",
        "shape": "shield filled + star",
        "color": "{accent}",
        "ringColor": "{accentVivid} double ring"
      }
    },
    "iconSize": {
      "inline": 14,
      "card": 16,
      "profile": 20
    }
  },
  "monetization": {
    "boostedLabel": {
      "zh": "推广",
      "en": "Boosted",
      "bg": "{accentSoft}",
      "fg": "{accentTextStrong}",
      "border": "{accentSoftLine}",
      "icon": "arrow-up-right 12px"
    },
    "sponsoredLabel": {
      "zh": "赞助",
      "en": "Sponsored",
      "bg": "{sunken}",
      "fg": "{ink2}",
      "border": "{line}",
      "icon": "none"
    },
    "rule": "Labels are always visible on the card, never hidden on hover, never styled as a 'premium' gold treatment."
  }
}
# Copy to .env (gitignored) or export in the shell. Relative paths resolve against the REPO ROOT.

# ---- server (server/src/config.ts) ----
PORT=4000
NODE_ENV=development
# SQLite file (created on boot; WAL). Module agents: DB_PATH=server/data/test-<key>.db
DB_PATH=server/data/app.db
# Public uploads (served at /uploads with 1-day cache). Private (verification) files go to UPLOAD_PRIVATE_DIR.
UPLOAD_DIR=server/uploads
UPLOAD_PRIVATE_DIR=server/data/private-uploads
# HS256 secret for the `sid` cookie JWT. Required in production.
JWT_SECRET=dev-secret-change-me
# Allowed browser origins (CORS + WebSocket Origin check), comma separated. localhost:*/127.0.0.1:* are always allowed outside production.
WEB_ORIGIN=http://localhost:5173
# Geocoding: Nominatim base URL (4 s timeout, cached in geocode_cache). GEOCODE_OFFLINE=1 skips the network and uses the campus-centroid fallback.
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODE_OFFLINE=
# pino level: trace|debug|info|warn|error|silent
LOG_LEVEL=info
# Testing switches: disable in-memory rate limits / scheduled jobs
RATE_LIMIT_DISABLED=
JOBS_DISABLED=
# Allow POST /api/dev/seed on a non test-*.db file
ALLOW_SEED_API=

# ---- web (web/vite.config.ts) ----
VITE_PORT=5173
VITE_API_TARGET=http://127.0.0.1:4000
